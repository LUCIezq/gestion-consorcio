@model PracticaParcial.Models.Reserva.ReservaSUM
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Agregar Reserva de SUM";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0" style="font-size:12px;font-weight:500;">
        <li class="breadcrumb-item">
            <a asp-controller="Consorcio"
               asp-action="Index"
               asp-route-id="@ViewBag.ConsorcioId"
               class="text-decoration-none text-muted">
                @ViewBag.NombreConsorcio
            </a>
        </li>

        <li class="breadcrumb-item">
            <a asp-controller="Unidades"
               asp-action="Index"
               asp-route-id="@ViewBag.ConsorcioId"
               class="text-decoration-none text-muted">
                Unidades
            </a>
        </li>

        <li class="breadcrumb-item">
            <a asp-controller="ReservasSUM"
               asp-action="Index"
               asp-route-consorcioId="@ViewBag.ConsorcioId"
               class="text-decoration-none text-muted">
                Reservas SUM
            </a>
        </li>

        <li class="breadcrumb-item active text-primary fw-bold">
            Agregar
        </li>
    </ol>
</nav>

<form asp-action="Agregar" method="post" asp-route-consorcioId="@ViewBag.ConsorcioId">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <label asp-for="Fecha">Fecha</label>
    <input asp-for="Fecha" type="date" class="form-control" />

    <label asp-for="Turno">Turno</label>
    <select asp-for="Turno" class="form-control">
        <option value="1">Mediodia</option>
        <option value="2">Noche</option>
    </select>

    <label asp-for="UnidadId">Unidad</label>
    <select asp-for="UnidadId" class="form-control">
        @foreach (var unidad in ViewBag.Unidades)
        {
            <option value="@unidad.IdUnidad">@unidad.Nombre</option>
        }
    </select>

    <label asp-for="Observaciones">Observaciones</label>
    <textarea asp-for="Observaciones" class="form-control"></textarea>

    <button type="submit" class="btn btn-success mt-3">
        Guardar
    </button>
</form>