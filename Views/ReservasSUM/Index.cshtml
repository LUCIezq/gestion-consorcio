@model List<PracticaParcial.Models.Reserva.ReservaSUM>
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Reservas SUM";
}
}
<h2>Reservas SUM</h2>

<a asp-action="Agregar" class="btn btn-primary">
    Nueva Reserva
</a>

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Turno</th>
            <th>Unidad</th>
            <th>Comentarios</th>
            <th>Entrego Correctamente</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Fecha</td>
                <td>@r.Turno</td>
                <td>@r.Unidad.Nombre</td>
                <td>@r.Observaciones</td>
                <td>@r.EntregoCorrectamente</td>
                <td>
                    <a asp-action="Eliminar" asp-route-id="@r.Id">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
