@model PracticaParcial.Models.Auth.Register.DTOs.RegisterViewModel

@{
    Layout = "_AnonimoLayout";
    ViewData["Title"] = "Registro";
}

<div class="container mt-5 d-flex justify-content-center m-auto">

    <div class="col-12 col-md-7 col-lg-4">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-sm-5">
                <h2 class="card-title text-center mb-4 fw-light">Crear Cuenta</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-success small mb-3">
                        <div class="d-flex gap-4 align-items-center">
                            @TempData["SuccessMessage"]
                        </div>
                    </div>
                }

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger text-center small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-normal">Email
                            <span class="text-danger small">
                                *
                            </span>
                        </label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="usuario@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-normal">Contraseña
                            <span class="text-danger small">
                                *
                            </span>
                        </label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-normal">Confirmar Contraseña
                            <span class="text-danger small">
                                *
                            </span>
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="********" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-dark">Registrarse</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="small mb-0">¿Ya tenés cuenta?
                        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none">Iniciá sesión acá</a>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}