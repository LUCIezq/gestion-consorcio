@model PracticaParcial.Models.Auth.Login.LoginViewModel

@{
    Layout = "_AnonimoLayout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5 d-flex justify-content-center m-auto">

    <div class="col-12 col-md-7 col-lg-4">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-sm-5">
                <h2 class="card-title text-center mb-4 fw-light">Iniciar Sesión</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-success text-center small mb-3">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Login" method="post" novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-danger text-center small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-normal">Email
                            <span class="text-danger small">*</span>
                        </label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="usuario@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-normal">Contraseña
                            <span class="text-danger small">*</span>
                        </label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="RememberMe">
                            Recordarme
                        </label>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-dark">Ingresar</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="small mb-0">¿No tenés cuenta?
                        <a asp-controller="Auth" asp-action="Register" class="text-decoration-none">Registrate acá</a>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}