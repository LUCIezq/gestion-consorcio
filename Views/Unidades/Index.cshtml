<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Listado General de Unidades</h2>
    <a asp-action="Agregar" class="btn btn-success">Nueva Unidad</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-secondary">
        <tr>
            <th>Consorcio</th>
            <th>Unidad</th>
            <th>Apellido</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Superficie (m²)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold text-primary">@item.NombreConsorcio</td>

                <td>@item.Nombre</td>

                <td>@item.ApellidoPropietario</td>
                <td>@item.NombrePropietario</td>
                <td>@item.EmailPropietario</td>
                <td>@item.Superficie</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.IdUnidad" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@item.IdUnidad" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>