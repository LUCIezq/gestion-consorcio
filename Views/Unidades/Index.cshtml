@model IEnumerable<PracticaParcial.Models.Unidades.DTOs.UnidadViewModel>

@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Unidades";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 m-0" style="font-size: 1.1rem;">
            <li class="breadcrumb-item">
                <a asp-controller="Consorcio" asp-action="Index" class="text-decoration-none">Mis Consorcios</a>
            </li>
            <li class="breadcrumb-item text-primary">
                <a asp-action="Detalle" asp-controller="Consorcio" asp-route-id="@ViewBag.ConsorcioId"
                   class="text-decoration-none">
                    @ViewBag.ConsorcioNombre
                </a>
            </li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Unidades</li>
        </ol>
    </nav>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Listado General de Unidades</h2>
    <a asp-action="Agregar" asp-route-id="@ViewBag.ConsorcioId" class="btn btn-success px-4">
        Nueva Unidad
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-secondary">
        <tr>
            <th>Consorcio</th>
            <th>Unidad</th>
            <th>Apellido</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Superficie (m²)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No hay unidades registradas para este consorcio.</td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold text-primary">
                    <a asp-action="Detalle" asp-controller="Consorcio" asp-route-id="@item.IdConsorcio"
                       class="text-decoration-none">
                        @item.NombreConsorcio
                    </a>
                </td>

                <td>@item.Nombre</td>

                <td>@item.ApellidoPropietario</td>
                <td>@item.NombrePropietario</td>
                <td>@item.EmailPropietario</td>
                <td>@item.Superficie</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.IdUnidad" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@item.IdUnidad"
                       class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>