@model IEnumerable<PracticaParcial.Models.Unidades.DTOs.UnidadViewModel>

@{
    ViewData["Title"] = "Unidades del Consorcio";
    Layout = "_UsuarioLayout";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Unidades</h2>

        <a asp-controller="Unidades" asp-action="Agregar" asp-route-consorcioId="@ViewBag.ConsorcioId"
           class="btn btn-outline-primary fw-bold shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Nueva Unidad
        </a>
        <a asp-action="Index" asp-controller="ReservasSUM" asp-route-consorcioId="@ViewBag.ConsorcioId"
           class="btn btn-outline-primary fw-bold shadow-sm d-flex align-items-center gap-2">
            SUM
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 12px; font-weight: 500;">
            <li class="breadcrumb-item">
                <a class="text-decoration-none text-muted" asp-action="Index" asp-controller="Consorcio">
                    Mis Consorcios
                </a>
            </li>
            <li class="breadcrumb-item">
                <a class="text-decoration-none text-muted" asp-action="Index" asp-controller="Consorcio"
                   asp-route-id="@ViewBag.ConsorcioId">
                    @ViewBag.NombreConsorcio
                </a>
            </li>
            <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">
                Unidades
            </li>
        </ol>
    </nav>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover text-center mb-0 align-middle">
            <thead class="table-secondary text-muted">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Apellido</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Mail</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.ApellidoPropietario</td>
                            <td>@item.NombrePropietario</td>
                            <td>@item.EmailPropietario</td>
                            <td>
                                <a asp-action="Editar" asp-controller="Unidades" asp-route-id="@item.IdUnidad"
                                   class="btn btn-link text-primary text-decoration-none p-0 me-3">
                                    Editar
                                </a>

                                <a asp-action="Eliminar" asp-controller="Unidades" asp-route-id="@item.IdUnidad"
                                   class="btn btn-link text-danger text-decoration-none p-0">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-muted py-4">No hay unidades registradas en este consorcio.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de Unidades" class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-controller="Unidades" asp-route-id="@ViewBag.ConsorcioId"
                       asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-controller="Unidades" asp-route-id="@ViewBag.ConsorcioId"
                           asp-route-pagina="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-controller="Unidades" asp-route-id="@ViewBag.ConsorcioId"
                       asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>