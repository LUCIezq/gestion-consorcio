@model PracticaParcial.Models.Unidades.DTOs.UnidadViewModel

@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Editar Unidad";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">

                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="card-title mb-0 fw-bold">Editar Unidad</h3>
                    <p class="mb-0 mt-1" style="font-size: 0.95rem;">
                        Edificio: <strong>@Model.NombreConsorcio</strong>
                    </p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="IdUnidad" />

                        <input type="hidden" asp-for="IdConsorcio" />
                        <input type="hidden" asp-for="NombreConsorcio" />
                      
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Identificador de la Unidad</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Depto 1° A o Local 2" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NombrePropietario" class="form-label fw-bold">Nombre del Propietario</label>
                                <input asp-for="NombrePropietario" class="form-control" />
                                <span asp-validation-for="NombrePropietario" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ApellidoPropietario" class="form-label fw-bold">Apellido del Propietario</label>
                                <input asp-for="ApellidoPropietario" class="form-control" />
                                <span asp-validation-for="ApellidoPropietario" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmailPropietario" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="EmailPropietario" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="EmailPropietario" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Superficie" class="form-label fw-bold">Superficie (m²)</label>
                                <input asp-for="Superficie" type="number" class="form-control" min="1" />
                                <span asp-validation-for="Superficie" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-4 mt-4">
                            <a asp-action="Index" class="btn btn-secondary px-4 border border-dark">
                                Cancelar
                            </a>
                            <a asp-action="Eliminar" asp-route-id="@Model.IdUnidad" class="btn btn-danger px-4 fw-bold border border-dark">
                                Eliminar Unidad
                            </a>
                            <button type="submit" class="btn btn-success px-4 border border-dark">
                                Guardar
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}