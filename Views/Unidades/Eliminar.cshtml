@model PracticaParcial.Models.Unidades.DTOs.UnidadViewModel

@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Eliminar Unidad";
}


<div class="container mt-5 pt-5 text-center">

    <h2 class="fw-bold text-dark mb-5" style="line-height: 1.6;">
        Esta seguro que desea Eliminar <br />
        la unidad "@Model.Nombre" del consorcio "@Model.NombreConsorcio"?
    </h2>

    <form asp-action="Eliminar" asp-route-id="@Model.IdUnidad" method="post" class="d-flex justify-content-center gap-4">

    <input type="hidden" name="idConsorcio" value="@Model.IdConsorcio" />

    <button type="submit" class="btn btn-secondary px-5 py-2 fw-bold text-dark" style="background-color: #e0e0e0; border-color: #ccc;">
        Eliminar
    </button>

    <a asp-action="Index" asp-route-id="@Model.IdConsorcio" class="btn btn-secondary px-5 py-2 fw-bold text-dark" style="background-color: #e0e0e0; border-color: #ccc;">
        Cancelar
    </a>

</form>

</div>