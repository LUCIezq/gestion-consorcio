@model PracticaParcial.Models.Unidades.DTOs.UnidadViewModel

@{
    ViewData["Title"] = "Eliminar Unidad";
}

<div class="container mt-5 text-center">

    <h2 class="display-6 fw-bold text-dark mb-5">
        Esta seguro que desea Eliminar<br />
        la unidad "@Model.Nombre" ?
    </h2>

    <form asp-action="Eliminar" method="post">
        <input type="hidden" name="id" value="@Model.IdUnidad" />

        <div class="d-flex justify-content-center gap-4">

            <a asp-action="Index" class="btn btn-secondary btn-lg px-5 border border-dark">
                Cancelar
            </a>

            <button type="submit" class="btn btn-danger btn-lg px-5 border border-dark">
                Eliminar
            </button>
        </div>
    </form>
</div>