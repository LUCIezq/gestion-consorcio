@model PracticaParcial.Models.Consorcios.DTOs.CreateConsorcioViewModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Editar Consorcio";
    Layout = "_UsuarioLayout";
}

<div class="main-wrapper">
    <main class="canvas-area">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0" style="font-size: 12px; font-weight: 500;">
                <li class="breadcrumb-item">
                    <a class="text-decoration-none text-muted" asp-action="Index" asp-controller="Consorcio">
                        Consorcios
                    </a>
                </li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">
                    @Model.Nombre
                </li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">
                    Editar Consorcio
                </li>
            </ol>
        </nav>

        <!-- Header -->
        <div class="mb-4">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show small mb-3"
                 role="alert" aria-live="polite">

                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small mb-3" role="alert" aria-live="polite">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h2 class="fw-bold">Editar Consorcio</h2>
            <p class="text-muted mb-0">
                Complete los detalles a continuación para editar un consorcio.
            </p>
        </div>

        <form method="post" asp-action="Editar" id="form" novalidate>

            <!-- Información Básica -->
            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Información Básica</h5>
                <small class="text-muted d-block mb-3">
                    Identificación principal del consorcio para su administración.
                </small>

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="Nombre">Nombre del Consorcio</label>
                    <input class="form-control form-control-lg fs-6" placeholder="Ej: Edificio Central Park I"
                           asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
            </div>

            <!-- Dirección -->
            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Dirección</h5>
                <small class="text-muted d-block mb-3">
                    Ubicación física y datos geográficos del complejo.
                </small>

                <div class="mb-3">
                    <label class="form-label-custom">Buscar dirección</label>
                    <input class="form-control" placeholder="Escriba la calle y altura..." type="text"
                           autocomplete="address-line1" id="select-address" />
                </div>

                <input type="hidden" asp-for="Latitud">
                <input type="hidden" asp-for="Longitud">

                <span asp-validation-for="Latitud" class="text-danger small"></span>
                <span asp-validation-for="Longitud" class="text-danger small"></span>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" asp-for="Calle" placeholder=" " />
                            <label asp-for="Calle">Calle</label>
                            <span asp-validation-for="Calle" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" asp-for="Provincia" placeholder=" "
                                   autocomplete="address-level1" />
                            <label asp-for="Provincia">Provincia</label>
                            <span asp-validation-for="Provincia" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" asp-for="Ciudad" placeholder=" "
                                   autocomplete="address-level2" />
                            <label asp-for="Ciudad">Ciudad</label>
                            <span asp-validation-for="Ciudad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" asp-for="CodigoPostal" placeholder=" "
                                   autocomplete="postal-code" />
                            <label asp-for="CodigoPostal">Código Postal</label>
                            <span asp-validation-for="CodigoPostal" class="text-danger small"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Ajustes -->
            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-1">Ajustes Generales</h5>
                <small class="text-muted d-block mb-3">
                    Configure reglas básicas de facturación y plazos.
                </small>

                <div style="max-width: 320px;">
                    <label class="form-label-custom" asp-for="DiaVencimientoExpensas">
                        Vencimiento de Expensas
                    </label>

                    <input class="form-control form-control-lg fs-6" type="number" asp-for="DiaVencimientoExpensas"
                           placeholder="1" />

                    <div class="form-text fst-italic" style="font-size: 11px;">
                        Día del mes en que vencen habitualmente las cuotas.
                    </div>

                    <span asp-validation-for="DiaVencimientoExpensas" class="text-danger small"></span>
                </div>
            </div>


            <div class="d-flex justify-content-start align-items-center gap-3 pt-3 border-top">

                <button class="btn btn-outline-primary fw-bold shadow-sm" type="submit">
                    Confirmar Edición
                </button>

                <a asp-action="Index" asp-controller="Consorcio"
                   class="btn btn-link text-decoration-none text-muted fw-bold">
                    Cancelar
                </a>

            </div>

        </form>

    </main>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script id="search-js" defer src="https://api.mapbox.com/search-js/v1.5.0/web.js"></script>
    <script type="module" src="~/js/Consorcio/MapBox.js"></script>
    <script>
        const mapboxAccessToken = '@Configuration["Mapbox:AccessToken"]';
    </script>
}