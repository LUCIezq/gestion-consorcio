@using Microsoft.Extensions.Configuration
@using PracticaParcial.shared
@inject IConfiguration Configuration

@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Index";
}

@model PaginatedList<PracticaParcial.Models.Consorcios.DTOs.ConsorcioDetailViewModel>

<h1>@ViewData["Title"]</h1>

<div id="map" class="map-box">
</div>

<div class="consorcios-panel h-75">
    <div class="panel-header">
        <h5>Mis Consorcios</h5>

        @if (Model.TotalCount > 0)
        {
            <span class="fw-bold text-black">@Model.TotalCount</span>
        }
    </div>

    <div style="flex: 1; overflow-y: auto;">
        @if (!Model.Items.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center gap-3 mt-5">
                <i class="bi bi-building fs-1 text-muted"></i>
                <p class="text-muted">No tienes consorcios creados aún.</p>
            </div>
        }
        else
        {
            @foreach (var consorcio in Model.Items)
            {
                <div class="consorcio-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <a asp-action="Detalle" asp-route-id="@consorcio.Id" class="consorcio-name">@consorcio.Nombre</a>

                        <div class="dropdown">

                            <svg xmlns="http://www.w3.org/2000/svg" width="16" role="button" id="dropdownMenuLink"
                                 data-bs-toggle="dropdown" aria-expanded="false" height="16" fill="currentColor"
                                 class="bi bi-three-dots-vertical" viewBox="0 0 16 16">
                                <path
                                d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0" />
                            </svg>

                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                <li><a class="dropdown-item" href="#">Unidades</a></li>
                                <li><a class="dropdown-item" href="#">Gastos</a></li>
                                <li><a class="dropdown-item" asp-controller="Expensas" asp-action="Index" asp-route-consorcioId="@consorcio.Id">Expensas</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="#">Editar</a></li>
                                <li>
                                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal"
                                            data-bs-target="#eliminarModal" data-id="@consorcio.Id" data-nombre="@consorcio.Nombre">
                                        Eliminar
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div>
                        <span class="text-muted consorcio-direction">@consorcio.Calle</span>
                        <span class="mx-1">-</span>
                        <span class="text-muted  consorcio-direction">@consorcio.Ciudad</span>
                        <span class="mx-1">-</span>
                        <span class="text-muted consorcio-direction">@consorcio.Provincia</span>
                    </div>

                </div>
            }
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-3 py-3 border-top"
             style="border-top-color: #f1f3f5 !important;">
            <nav aria-label="Paginación de consorcios">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" tabindex="-1"
                           aria-disabled="@(!Model.HasPreviousPage)">Anterior</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                           aria-disabled="@(!Model.HasNextPage)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }

    <button class="nuevo-btn">
        <a asp-action="Guardar" class="text-white nuevo-consorcio" asp-controller="Consorcio">+ Nuevo Consorcio</a>
    </button>
</div>

<div class="modal fade" id="eliminarModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <p id="mensajeEliminar"></p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <form asp-action="Eliminar" asp-controller="Consorcio" method="post">

                    <input type="hidden" id="consorcioId" name="id" />

                    <button type="submit" class="btn btn-danger">
                        Eliminar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">

        <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive"
             aria-atomic="true">

            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                </div>

                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast">
                </button>
            </div>

        </div>

    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
            <div id="errorToast" class="toast text-bg-danger border-0">

                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["ErrorMessage"]
                    </div>

                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast">
                    </button>
                </div>

            </div>
        </div>
    }

}
@section Styles {
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.24.0/mapbox-gl.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/ConsorcioIndex.css" />
}

@section Scripts {
    <script>
        const mapboxAccessToken = '@Configuration["Mapbox:AccessToken"]';
    </script>

    <script src="https://api.mapbox.com/mapbox-gl-js/v3.24.0/mapbox-gl.js"></script>
    <script src="~/js/Consorcio/Map-MapBox.js"></script>
    <script src="~/js/Consorcio/Modal.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {

        document.querySelectorAll('.toast').forEach(toastElement => {

        const toast = new bootstrap.Toast(toastElement, {
        delay: 5000
        });

        toast.show();
        });

        });
    </script>

}
