@{
    Layout = "BaseLayout";
}

@section Styles {
    @RenderSection("Styles", required: false)
}

@section Menu {
    <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom shadow-sm py-3 mb-4">
        <ul class="navbar-nav ms-auto align-items-center gap-2">
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Consorcio" asp-action="Index">Mis Consorcios</a>
            </li>
            <form asp-action="Logout" asp-controller="Auth" method="post">
                <li class="nav-item ms-md-2 mt-2 mt-md-0">
                    <button class="btn btn-outline-danger rounded-pill px-4" type="submit">Salir</button>
                </li>
            </form>
        </ul>
    </nav>
}

<div class="container mt-3">
    @await RenderSectionAsync("Breadcrumb", required: false)
</div>

@RenderBody()
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)