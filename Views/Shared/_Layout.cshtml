<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionDeConsorcio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PracticaParcial.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap"
          rel="stylesheet" />
    <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Consorcio.css" asp-append-version="true" />
</head>

<body>
    <aside class="sidebar">
        <div class="d-flex align-items-center gap-2 mb-4 px-2">
            <div class="bg-primary text-white p-2 rounded-3">
                <span class="material-symbols-outlined">account_balance</span>
            </div>
            <div>
                <h5 class="m-0 fw-bold text-primary" style="font-size: 1rem; line-height: 1;">
                    Consorcios UNLAM
                </h5>
                <small class="text-uppercase fw-bold text-muted" style="font-size: 10px; letter-spacing: 0.5px;">Portal
                    de consorcios</small>
                </div>
            </div>
            <nav class="nav flex-column flex-grow-1">
                <a class="nav-link" asp-action="Index" asp-controller="Home">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span>Inicio</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link active" asp-action="Index" asp-controller="Consorcio">
                        <span class="material-symbols-outlined">account_balance_wallet</span>
                        <span>Consorcios</span>
                    </a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-auto">
                    <form asp-action="Logout" asp-controller="Auth" method="post" class="m-0">
                        <button type="submit" class="nav-link text-danger bg-transparent border-0 w-100 text-start m-0">
                            <span class="material-symbols-outlined">logout</span>
                            <span>Cerrar sesión</span>
                        </button>
                    </form>
                </div>
            }
        </aside>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>

