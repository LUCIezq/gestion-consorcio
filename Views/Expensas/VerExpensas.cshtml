@model PracticaParcial.Models.Expensas.DTO.VerExpensasViewModel
@{
    ViewData["Title"] = "Ver Expensas";
    Layout = "_UsuarioLayout";
}
@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 m-0" style="font-size: 1.1rem;">
            <li class="breadcrumb-item">
                <a asp-controller="Consorcio" asp-action="Index" class="text-decoration-none">Mis Consorcios</a>
            </li>
            <li class="breadcrumb-item text-primary">
                @Model.NombreConsorcio
            </li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Expensas</li>
        </ol>
    </nav>
}
<div class="main-wrapper">
    <main class="canvas-area">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Expensas</h2>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Gasto Total Mes Actual</h6>
                        <h3>$@Model.Resumen.TotalMesActual</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Unidades</h6>
                        <h3>@Model.Resumen.CantidadUnidades</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Monto por Unidad</h6>
                        <h3>$@Model.Resumen.MontoPorUnidades</h3>
                    </div>
                </div>
            </div>

        </div>
        <div class="card p-4 shadow-sm mb-3">
            <div class="table-responsive">
                <table id="tablaGastos" class="table table-hover align-middle url-perfil mb-0"
                       style="width:100%; font-size: 14px;">
                    <thead class="table-light text-secondary fw-semibold">
                        <tr>
                            <th class="border-0">Año</th>
                            <th class="border-0">Mes</th>
                            <th class="border-0">Gasto Total ($)</th>
                            <th class="border-0">Expensas por Unidad</th>
                        </tr>
                    </thead>
                    <tbody id="expensasBody">
                    </tbody>
                </table>
            </div>
        </div>

    </main>
    @section Scripts
    {
        <script>

                const consorcioId = @Model.ConsorcioId;

                fetch(`/api/ExpensasApi/${consorcioId}`)
                    .then(response => response.json())
                    .then(expensas => {

                        const tbody =
                            document.getElementById("expensasBody");

                        expensas.forEach(expensa => {

                            tbody.innerHTML += `
                                <tr>
                                    <td>${expensa.anio}</td>
                                    <td>${expensa.mes}</td>
                                    <td>$${expensa.totalGastos}</td>
                                    <td>$${expensa.montoPorUnidad}</td>
                                </tr>
                            `;
                        });
                    });
        </script>
    }
</div>