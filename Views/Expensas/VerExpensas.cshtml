@model PracticaParcial.Models.Expensas.DTO.VerExpensasViewModel
@{
    ViewData["Title"] = "Ver Expensas";
    Layout = "_UsuarioLayout";
}
@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 m-0" style="font-size: 1.1rem;">
            <li class="breadcrumb-item">
                <a asp-controller="Consorcio" asp-action="Index" class="text-decoration-none">Mis Consorcios</a>
            </li>
            <li class="breadcrumb-item text-primary">
                Consorcio "@ViewBag.NombreConsorcio"
            </li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Unidades</li>
        </ol>
    </nav>
}
<div class="main-wrapper">
    <main class="canvas-area">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Expensas</h2>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Gasto Total Mes Actual</h6>
                        <h3>$@Model.Resumen.TotalMesActual</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Unidades</h6>
                        <h3>@Model.Resumen.CantidadUnidades</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6>Monto por Unidad</h6>
                        <h3>$@Model.Resumen.MontoPorUnidades</h3>
                    </div>
                </div>
            </div>

        </div>
        <div class="card p-4 shadow-sm mb-3">
            <div class="table-responsive">
                <table id="tablaGastos" class="table table-hover align-middle url-perfil mb-0" style="width:100%; font-size: 14px;">
                    <thead class="table-light text-secondary fw-semibold">
                        <tr>
                            <th class="border-0">Año</th>
                            <th class="border-0">Mes</th>
                            <th class="border-0">Gasto Total ($)</th>
                            <th class="border-0">Expensas por Unidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expensa in Model.Expensas)
                            {
                                <tr>
                                    <td class="text-muted">@expensa.Anio</td>
                                    <td class="text-muted">@expensa.Mes</td>
                                    <td class="text-muted">@expensa.TotalGastos</td>
                                    <td class="text-muted">@expensa.MontoPorUnidad</td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>