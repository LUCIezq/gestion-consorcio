@model IEnumerable<PracticaParcial.Models.Gastos.DTos.GastoViewModel>
@{
    ViewData["Title"] = "Ver Expensas";
    Layout = "_UsuarioLayout";
}

<div class="main-wrapper">
    <main class="canvas-area">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Expensas</h2>
            </div>
        </div>
        <div class="card p-4 shadow-sm mb-3">
            <div class="table-responsive">
                <table id="tablaGastos" class="table table-hover align-middle url-perfil mb-0" style="width:100%; font-size: 14px;">
                    <thead class="table-light text-secondary fw-semibold">
                        <tr>
                            <th class="border-0">Año</th>
                            <th class="border-0">Mes</th>
                            <th class="border-0">Gasto Total ($)</th>
                            <th class="border-0">Expensas por Unidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var expensa in Model)
                            {
                                <tr>
                                    <td class="text-muted">@expensa.AnioExpensa</td>
                                    <td class="text-muted">@expensa.MesExpensa</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle d-block fs-4 mb-2 text-muted"></i>
                                    No se encontraron gastos registrados para este consorcio.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>