@{
    Layout = "_AnonimoLayout"; 
    ViewData["Title"] = "Inicio";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">
    
    <h1 class="display-5 text-center text-dark fw-bold mb-5">
        Sistema para la Administración de Consorcios
    </h1>

    <div class="d-flex flex-column flex-sm-row gap-3 mt-3">
        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-sm">
            Ingresar
        </a>
        <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-primary btn-lg px-5 shadow-sm">
            Registrarse
        </a>
    </div>

</div>