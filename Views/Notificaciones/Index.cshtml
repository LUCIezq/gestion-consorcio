@* @model List<PracticaParcial.Models.Notificaciones.Notificacion> *@
@model List<PracticaParcial.Models.Notificaciones.DTO.MostrarNotificacionesViewModel>

@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Notificaciones";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-3">
        <ul class="breadcrumb mb-0" style="font-size: 12px; font-weight: 500;">
            <li class="breadcrumb-item">
                <a class="text-decoration-none text-muted" asp-action="Index" asp-controller="Consorcio">
                    Mis Consorcios
                </a>
            </li>
            <li class="breadcrumb-item">
                <a class="text-decoration-none text-muted" asp-action="Index" asp-controller="Consorcio"
                   asp-route-id="@ViewBag.ConsorcioId">
                    @ViewBag.consorcioNombre
                </a>
            </li>
            <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">
                Notificaciones
            </li>
        </ul>
    </nav>
}

<h3>@ViewBag.UserId</h3>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="fw-bold mb-0">Listado General de Notificaciones</h2>

    <a asp-action="Agregar" asp-route-id="@ViewBag.ConsorcioId"
       class="btn btn-outline-primary fw-bold shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i> Nueva notificación
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-secondary">
        <tr>
            <th>Titulo</th>
            <th>Descripcion</th>
            <th>Fecha de creacion</th>
            <th>Fecha de Envio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">
                    <i class="bi bi-info-circle d-block fs-4 mb-2 text-muted"></i>
                    No se encontraron notificaciones registradas para este consorcio.
                </td>
            </tr>
        }
        else
        {
            @foreach (var notificacion in Model)
            {
                <tr>
                    <td class="fw-bold text-primary">
                        @if (notificacion.FechaDeEnvio == null)
                        {
                            <a asp-action="Editar" asp-route-idNotificacion="@notificacion.Id"
                               class="text-decoration-none">@notificacion.Titulo</a>
                        }
                        else
                        {
                            <a asp-action="VerDetalle" asp-route-id="@notificacion.Id"
                               class="text-decoration-none">@notificacion.Titulo</a>
                        }
                    </td>
                    <td>@notificacion.Descripcion</td>
                    <td>@notificacion.FechaDeCreacion</td>
                    <td>
                        @if (notificacion.FechaDeEnvio == null)
                        {
                            @:No se envio Aun
                        }
                        else
                        {
                            @notificacion.FechaDeEnvio
                        }
                    </td>
                    <td>
                        @if (notificacion.FechaDeEnvio == null)
                        {
                            <a asp-action="Eliminar" asp-route-id="@notificacion.Id"
                               class="btn btn-sm btn-outline-secondary">Eliminar</a>
                            <a asp-action="Enviar" asp-route-id="@notificacion.Id"
                               class="btn btn-sm btn-outline-secondary">Enviar</a>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-outline-secondary">
                                Enviada</span>
                            }
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>