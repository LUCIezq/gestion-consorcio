@model IEnumerable<PracticaParcial.Models.Gastos.DTos.GastoViewModel>
@{
    ViewData["Title"] = "Gastos del Consorcio";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Consorcio" asp-action="Index">Mis Consorcios</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gastos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gastos</h2>
        <a asp-controller="Gastos" asp-action="Agregar" asp-route-id="@ViewBag.IdConsorcio" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Nuevo Gasto
        </a>
    </div>

    <div class="card shadow-sm p-3">
        <table id="tablaGastos" class="table table-striped table-bordered url-perfil" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>Año</th>
                    <th>Mes</th>
                    <th>Nombre</th>
                    <th>Tipo Gasto</th>
                    <th>Fecha</th>
                    <th>Monto ($)</th>
                    <th>Comprobante</th>
                    <th>Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var gasto in Model)
                    {
                        <tr>
                            <td>@gasto.AnioExpensa</td>
                            <td>@gasto.MesExpensa</td>
                            <td>
                                <a asp-controller="Gastos"
                                   asp-action="Editar"
                                   asp-route-idConsorcio="@gasto.IdConsorcio"
                                   asp-route-idGasto="@gasto.Id"
                                   class="text-decoration-none fw-bold">
                                    @gasto.Nombre
                                </a>
                            </td>

                            <td>@gasto.NombreTipoGasto</td>
                            <td>@gasto.FechaGasto.ToString("dd/MM/yyyy")</td>
                            <td>@gasto.Monto.ToString("F2")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(gasto.ArchivoComprobanteGuardado))
                                {
                                    <a href="@Url.Action("DescargarComprobante", "Gastos", new { archivo = gasto.ArchivoComprobanteGuardado })"
                                       class="btn btn-sm btn-link">
                                        Descargar Comprobante
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted text-center">Sin archivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" method="post" onsubmit="return confirm('¿Está seguro de que desea eliminar este gasto?');">

                                    <input type="hidden" name="id" value="@gasto.Id" />

                                    <input type="hidden" name="idConsorcio" value="@gasto.IdConsorcio" />

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

