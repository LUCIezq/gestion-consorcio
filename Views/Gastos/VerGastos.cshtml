@model IEnumerable<PracticaParcial.Models.Gastos.DTos.GastoViewModel>
@{
    ViewData["Title"] = "Gastos del Consorcio";
    Layout = "_UsuarioLayout";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-transparent p-0 m-0" style="font-size: 1.1rem;">
            <li class="breadcrumb-item">
                <a asp-controller="Consorcio" asp-action="Index" class="text-decoration-none">Mis Consorcios</a>
            </li>
            <li class="breadcrumb-item text-primary">
                @ViewBag.ConsorcioNombre
            </li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Gastos</li>
        </ol>
    </nav>
}

<div class="main-wrapper">
    <main class="canvas-area">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Gastos</h2>
            </div>

            <a asp-controller="Gastos" asp-action="Agregar" asp-route-id="@ViewBag.IdConsorcio"
               class="btn btn-outline-primary fw-bold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Nuevo Gasto
            </a>
        </div>
        <div class="card p-4 shadow-sm mb-3">
            <div class="table-responsive">
                <table id="tablaGastos" class="table table-hover align-middle url-perfil mb-0"
                       style="width:100%; font-size: 14px;">
                    <thead class="table-light text-secondary fw-semibold">
                        <tr>
                            <th class="border-0">Año</th>
                            <th class="border-0">Mes</th>
                            <th class="border-0">Nombre</th>
                            <th class="border-0">Tipo Gasto</th>
                            <th class="border-0">Fecha</th>
                            <th class="border-0">Monto</th>
                            <th class="border-0 text-center">Comprobante</th>
                            <th class="border-0 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var gasto in Model)
                            {
                                <tr>
                                    <td class="text-muted">@gasto.AnioExpensa</td>
                                    <td class="text-muted">@gasto.MesExpensa</td>
                                    <td>
                                        <a asp-controller="Gastos" asp-action="Editar"
                                           asp-route-idConsorcio="@gasto.IdConsorcio" asp-route-idGasto="@gasto.Id"
                                           class="text-decoration-none text-primary fw-bold">
                                            @gasto.Nombre
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1.5" style="font-weight: 500;">
                                            @gasto.NombreTipoGasto
                                        </span>
                                    </td>
                                    <td>@gasto.FechaGasto.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-dark">$@gasto.Monto.ToString("F2")</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(gasto.ArchivoComprobanteGuardado))
                                        {
                                            <a href="@Url.Action("DescargarComprobante", "Gastos", new { archivo = gasto.ArchivoComprobanteGuardado })"
                                               class="btn btn-link btn-sm text-decoration-none p-0 fw-semibold text-primary">
                                                <i class="bi bi-download me-1"></i> Descargar
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Sin adjunto</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="Eliminar" method="post"
                                              onsubmit="return confirm('¿Está seguro de que desea eliminar este gasto?');"
                                              class="d-inline">
                                            <input type="hidden" name="id" value="@gasto.Id" />
                                            <input type="hidden" name="idConsorcio" value="@gasto.IdConsorcio" />

                                            <button type="submit"
                                                    class="btn btn-link text-danger text-decoration-none p-0 small fw-semibold">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle d-block fs-4 mb-2 text-muted"></i>
                                    No se encontraron gastos registrados para este consorcio.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>