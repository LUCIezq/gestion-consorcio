@model List<PracticaParcial.Models.Gastos.Gasto>
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Gastos";
}

<table class="table">
    <thead>
        <tr>
            <th>Año</th>
            <th>Mes</th>
            <th>Nombre</th>
            <th>Tipo Gasto</th>
            <th>Fecha</th>
            <th>Monto ($)</th>
            <th>Eliminar</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var g in Model)
        {
            <tr>
                <td>@g.Fecha.Year</td>
                <td>@g.Fecha.Month</td>
                <td>@g.Nombre</td>
                <td>@g.Descripcion</td>
                <td>@g.Fecha</td>
                <td>@g.Importe</td>
                <td>
                    <a asp-action="Eliminar" asp-route-id="@g.Id">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>