@model PracticaParcial.Models.Gastos.DTos.GastoViewModel

<h2>Editar Gasto</h2>

<form asp-controller="Gastos" asp-action="Editar" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IdConsorcio" />
    <input type="hidden" asp-for="ArchivoComprobanteGuardado" />


    <div class="form-group mb-3">
        <label asp-for="IdTipoGasto">Tipo de Gasto:</label>
        <select class="form-control" asp-for="IdTipoGasto">
            <option value="">-- Seleccione un tipo --</option>
            @if (ViewBag.TiposGasto != null)
            {
                foreach (var tipo in ViewBag.TiposGasto)
                {
                    <option value="@tipo.Id">@tipo.Nombre</option>
                }
            }
        </select>
        <span asp-validation-for="IdTipoGasto" class="text-danger"></span>
    </div>


    <div class="form-group mb-3">
        <label asp-for="Nombre">Nombre:</label>
        <input type="text" class="form-control" asp-for="Nombre">
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Descripcion">Descripcion:</label>
        <input type="text" class="form-control" asp-for="Descripcion" />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>


    <div class="form-group mb-3">
        <label asp-for="Monto">Monto ($):</label>
        <input type="number" step="0.01" class="form-control" asp-for="Monto">
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaGasto">Fecha:</label>
        <input type="date" class="form-control" asp-for="FechaGasto">
        <span asp-validation-for="FechaGasto" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Expensa (*):</label>
        <div class="d-flex align-items-center gap-2">
            <label asp-for="AnioExpensa">Año:</label>
            <input type="number" class="form-control" style="width: 80px;" asp-for="AnioExpensa">

            <label asp-for="MesExpensa">Mes:</label>
            <input type="number" class="form-control" style="width: 60px;" asp-for="MesExpensa" min="1" max="12">
        </div>
        <span asp-validation-for="AnioExpensa" class="text-danger"></span>
        <span asp-validation-for="MesExpensa" class="text-danger"></span>
    </div>

  

    <label>Comprobante (*):</label>

    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(Model.ArchivoComprobanteGuardado))
        {
            <span class="me-2">Comprobante actual: <strong>@Model.ArchivoComprobanteGuardado</strong></span>

            <a href="@Url.Action("DescargarComprobante", "Gastos", new { archivo = Model.ArchivoComprobanteGuardado })"
               class="btn btn-sm btn-info text-nowrap">

                Ver Comprobante

            </a>

            <button type="button"
                    id="editarComprobante"
                    class="btn btn-sm btn-info text-nowrap"
                    onclick="botonAgregarArchivo()">
                Editar Comprobante
            </button>
        }
    </div>
    <div id="contenedorArchivo" class="mb-2 mt-4 @(string.IsNullOrEmpty(Model.ArchivoComprobanteGuardado) ? "" : "d-none")">
        <input type="file" asp-for="ArchivoComprobante" class="form-control">
    </div>

    <span asp-validation-for="ArchivoComprobante" class="text-danger"></span>

    <div class="mt-5">
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a href="@Url.Action("VerGastos", new { id = Model.IdConsorcio })" class="btn-secondary">Cancelar</a>
    </div>
   
</form>

<script src="~/js/Gasto/editar.js"></script>
