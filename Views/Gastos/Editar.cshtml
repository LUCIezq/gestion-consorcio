@model PracticaParcial.Models.Gastos.DTos.GastoViewModel
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Editar Gasto";
}

<div class="main-wrapper">
    <main class="canvas-area">

        <div class="mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show small mb-3"
                 role="alert" aria-live="polite">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            <h2 class="fw-bold">Editar Gasto</h2>
        </div>

        <form asp-controller="Gastos" asp-action="Editar" method="post" enctype="multipart/form-data" novalidate>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IdConsorcio" />
            <input type="hidden" asp-for="ArchivoComprobanteGuardado" />

            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Información del Gasto</h5>
                <small class="text-muted d-block mb-3">
                    Modifique la clasificación o el concepto principal de la erogación.
                </small>

                <div class="mb-3">
                    <label asp-for="IdTipoGasto" class="form-label-custom">Tipo de Gasto:</label>
                    <select class="form-select form-control-lg fs-6" asp-for="IdTipoGasto">
                        <option value="">-- Seleccione un tipo --</option>
                        @if (ViewBag.TiposGasto != null)
                        {
                            foreach (var tipo in ViewBag.TiposGasto)
                            {
                                <option value="@tipo.Id">@tipo.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdTipoGasto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label-custom">Nombre:</label>
                    <input type="text" class="form-control form-control-lg fs-6" asp-for="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label-custom">Descripcion:</label>
                    <input type="text" class="form-control form-control-lg fs-6" asp-for="Descripcion" />
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Período e Importe</h5>
                <small class="text-muted d-block mb-3">
                    Actualice los montos económicos y las fechas de imputación correspondientes.
                </small>

                <div class="row g-4 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label-custom">Monto ($):</label>
                        <input type="number" step="0.01" class="form-control form-control-lg fs-6" asp-for="Monto" />
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FechaGasto" class="form-label-custom">Fecha:</label>
                        <input type="date" class="form-control form-control-lg fs-6" asp-for="FechaGasto" />
                        <span asp-validation-for="FechaGasto" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label-custom">Expensa (*):</label>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <label asp-for="AnioExpensa" class="mb-0 small text-muted">Año:</label>
                            <input type="number" class="form-control form-control-lg fs-6" style="width: 100px;" asp-for="AnioExpensa" />
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <label asp-for="MesExpensa" class="mb-0 small text-muted">Mes:</label>
                            <input type="number" class="form-control form-control-lg fs-6" style="width: 80px;" asp-for="MesExpensa" min="1" max="12" />
                        </div>
                    </div>
                    <span asp-validation-for="AnioExpensa" class="text-danger small d-block mt-1"></span>
                    <span asp-validation-for="MesExpensa" class="text-danger small d-block"></span>
                </div>
            </div>
            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-1">Comprobante (*):</h5>
                <small class="text-muted d-block mb-3">
                    Gestione o reemplace el documento digital adjunto a esta erogación.
                </small>

                <div class="d-flex align-items-center gap-2 mb-3">
                    @if (!string.IsNullOrEmpty(Model.ArchivoComprobanteGuardado))
                    {
                        <span class="me-2">Comprobante actual: <strong>@Model.ArchivoComprobanteGuardado</strong></span>

                        <a href="@Url.Action("DescargarComprobante", "Gastos", new { archivo = Model.ArchivoComprobanteGuardado })"
                           class="btn btn-sm btn-outline-primary fw-bold shadow-sm text-nowrap">
                            Ver Comprobante
                        </a>

                        <button type="button"
                                id="editarComprobante"
                                class="btn btn-sm btn-outline-primary fw-bold shadow-sm text-nowrap"
                                onclick="botonAgregarArchivo()">
                            Editar Comprobante
                        </button>
                    }
                </div>

                <div id="contenedorArchivo" class="mb-2 @(string.IsNullOrEmpty(Model.ArchivoComprobanteGuardado) ? "" : "d-none")">
                    <input type="file" asp-for="ArchivoComprobante" class="form-control form-control-lg fs-6">
                </div>

                <span asp-validation-for="ArchivoComprobante" class="text-danger small"></span>
            </div>
            <div class="d-flex justify-content-start align-items-center gap-3 pt-3 border-top">
                <button type="submit" class="btn btn-outline-primary fw-bold shadow-sm">
                    Guardar Cambios
                </button>

                <a href="@Url.Action("VerGastos", new { id = Model.IdConsorcio })"
                   class="btn btn-link text-decoration-none text-muted fw-bold">
                    Cancelar
                </a>
            </div>

        </form>
    </main>
</div>


    <script src="~/js/Gasto/editar.js"></script>
