@model PracticaParcial.Models.Gastos.DTos.GastoViewModel
@{
    Layout = "_UsuarioLayout";
    ViewData["Title"] = "Agregar Gasto";
}

<div class="main-wrapper">
    <main class="canvas-area">
        <div class="mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show small mb-3"
                 role="alert" aria-live="polite">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

            @if (TempData["MensajeExitoso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show small mb-3" role="alert" aria-live="polite">
                    @TempData["MensajeExitoso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h2 class="fw-bold">Cargar Nuevo Gasto</h2>
            <p class="text-muted mb-0">
                Complete la información detallada del comprobante para imputarlo a las expensas del consorcio.
            </p>
        </div>

        <form asp-controller="Gastos" asp-action="AgregarGasto" method="post" enctype="multipart/form-data" novalidate>
            
            <input type="hidden" asp-for="IdConsorcio" value="@ViewBag.IdConsorcio" />

            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Información del Gasto</h5>
                <small class="text-muted d-block mb-3">
                    Detalles principales y clasificación de la erogación.
                </small>

                <div class="mb-3">
                    <label asp-for="IdTipoGasto" class="form-label-custom">Tipo de Gasto (*)</label>
                    <select asp-for="IdTipoGasto" class="form-select form-control-lg fs-6" required>
                        <option value="">-- Seleccione un tipo --</option>
                        @if (ViewBag.TiposGasto != null)
                        {
                            foreach (var tipo in ViewBag.TiposGasto)
                            {
                                <option value="@tipo.Id">@tipo.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="IdTipoGasto" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label-custom">Nombre del Gasto (*)</label>
                    <input type="text" class="form-control form-control-lg fs-6" placeholder="Ej: Pago de abono de ascensor" asp-for="Nombre" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label-custom">Descripción (*)</label>
                    <textarea class="form-control fs-6" asp-for="Descripcion" rows="2" placeholder="Detalles adicionales del gasto..." required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>

            <div class="card p-4 mb-3">
                <h5 class="fw-bold mb-1">Período e Imputación</h5>
                <small class="text-muted d-block mb-3">
                    Establezca la fecha de emisión y el período de expensas correspondiente.
                </small>

                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="date" class="form-control" asp-for="FechaGasto" placeholder=" " required />
                            <label asp-for="FechaGasto">Fecha del Gasto</label>
                            <span asp-validation-for="FechaGasto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="number" class="form-control" asp-for="AnioExpensa" min="2025" max="2030" placeholder=" " required />
                            <label asp-for="AnioExpensa">Año Expensa</label>
                            <span asp-validation-for="AnioExpensa" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input type="number" class="form-control" asp-for="MesExpensa" min="1" max="12" placeholder=" " required />
                            <label asp-for="MesExpensa">Mes Expensa</label>
                            <span asp-validation-for="MesExpensa" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card p-4 mb-4">
                <h5 class="fw-bold mb-1">Montos y Adjuntos</h5>
                <small class="text-muted d-block mb-3">
                    Especifique el valor económico total e incorpore el archivo de respaldo.
                </small>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label-custom">Monto (*)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold text-muted">$</span>
                            <input type="number" step="0.01" class="form-control form-control-lg fs-6" asp-for="Monto" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ArchivoComprobante" class="form-label-custom">Comprobante Adjunto (PDF o Imagen)</label>
                        <input type="file" class="form-control form-control-lg fs-6" asp-for="ArchivoComprobante" />
                        <span asp-validation-for="ArchivoComprobante" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-start align-items-center gap-3 pt-3 border-top">
                
                <button type="submit" name="accion" value="Guardar" class="btn btn-outline-primary fw-bold shadow-sm">
                    Guardar Gasto
                </button>

                <button type="submit" name="accion" value="CrearOtroGasto" class="btn btn-outline-primary fw-bold shadow-sm">
                    Guardar y Crear Otro Gasto
                </button>

                <a asp-controller="Gastos" asp-action="VerGastos" asp-route-id="@ViewBag.IdConsorcio" 
                   class="btn btn-link text-decoration-none text-muted fw-bold">
                    Cancelar
                </a>

            </div>

        </form>

    </main>
</div>

